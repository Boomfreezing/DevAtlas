      "expected_evidence": [
        {
          "file_path": "src/routes.ts",
          "start_line": 4,
          "end_line": 4,
          "contains": [
            "app.post(\"/orders\""
          ]
        }
      ],
      "expected_facts": [
        "POST /orders；传入 request.body.items。"
      ]
    },
    {
      "id": "orders-04",
      "repository": "orders",
      "category": "database",
      "question": "createOrder 最后写入哪张表？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/repository.ts",
          "start_line": 2,
          "end_line": 2,
          "contains": [
            "INSERT INTO orders"
          ]
        },
        {
          "file_path": "src/orders.ts",
          "start_line": 6,
          "end_line": 6,
          "contains": [
            "return insertOrder"
          ]
        }
      ],
      "expected_facts": [
        "createOrder 通过 insertOrder 写入 orders.total_cents。"
      ]
    },
    {
      "id": "orders-05",
      "repository": "orders",
      "category": "impact",
      "question": "修改 createOrder 会影响什么？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/routes.ts",
          "start_line": 6,
          "end_line": 6,
          "contains": [
            "await createOrder"
          ]
        },
        {
          "file_path": "tests/orders.spec.ts",
          "start_line": 5,
          "end_line": 5,
          "contains": [
            "createOrder(db, [])"
          ]
        }
      ],
      "expected_facts": [
        "影响订单路由和空订单测试；其他运行时调用无法仅由这些证据断言。"
      ]
    },
    {
      "id": "orders-06",
      "repository": "orders",
      "category": "config",
      "question": "PORT 环境变量的默认值是多少？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/config.ts",
          "start_line": 2,
          "end_line": 2,
          "contains": [
            "process.env.PORT ?? \"8200\""
          ]
        }
      ],
      "expected_facts": [
        "PORT 默认 8200。"
      ]
    },
    {
      "id": "orders-07",
      "repository": "orders",
      "category": "test",
      "question": "Which tests cover createOrder?",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "tests/orders.spec.ts",
          "start_line": 3,
          "end_line": 3,
          "contains": [
            "function checkEmptyOrder"
          ]
        }
      ],
      "expected_facts": [
        "checkEmptyOrder 验证空订单。"
      ]
    },
    {
      "id": "orders-08",
      "repository": "orders",
      "category": "error",
      "question": "empty order 异常如何返回给客户端？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/routes.ts",
          "start_line": 9,
          "end_line": 9,
          "contains": [
