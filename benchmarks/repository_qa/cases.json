    {
      "id": "orders-09",
      "repository": "orders",
      "category": "follow_up",
      "question": "它最后写入哪张表？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/repository.ts",
          "start_line": 2,
          "end_line": 2,
          "contains": [
            "INSERT INTO orders"
          ]
        }
      ],
      "expected_facts": [
        "上一轮的 createOrder 写入 orders 表。"
      ],
      "history": [
        {
          "role": "user",
          "content": "createOrder 在哪里？"
        },
        {
          "role": "assistant",
          "content": "`createOrder` 定义在 `src/orders.ts:3-7`。"
        }
      ]
    },
    {
      "id": "orders-10",
      "repository": "orders",
