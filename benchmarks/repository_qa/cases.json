{
  "version": "1.0.0",
  "description": "36 个维护者可复核的标注问题；3 个自建合成源码样例，不代表真实大型仓库或生成模型准确率。",
  "cases": [
    {
      "id": "accounts-01",
      "repository": "accounts",
      "category": "startup",
      "question": "这个项目如何启动？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "README.md",
          "start_line": 8,
          "end_line": 8,
          "contains": [
            "uvicorn src.api:app"
          ]
        }
      ],
      "expected_facts": [
        "使用 uvicorn src.api:app --host 127.0.0.1 --port 8100 启动。"
      ]
    },
    {
      "id": "accounts-02",
      "repository": "accounts",
      "category": "location",
      "question": "登录功能在哪里？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/auth.py",
          "start_line": 4,
          "end_line": 4,
          "contains": [
            "def login_user"
          ]
        }
      ],
      "expected_facts": [
        "实现位于 src/auth.py 的 login_user；不要把生成的 JavaScript SDK 当成服务端。"
      ]
    },
    {
      "id": "accounts-03",
      "repository": "accounts",
      "category": "api",
      "question": "创建会话的接口路径是什么？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/api.py",
          "start_line": 8,
          "end_line": 8,
          "contains": [
            "@app.post(\"/sessions\")"
          ]
        }
      ],
      "expected_facts": [
        "POST /sessions，对应 create_session。"
      ]
    },
    {
      "id": "accounts-04",
      "repository": "accounts",
      "category": "database",
      "question": "login_user 最后访问哪张表？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/models.py",
          "start_line": 4,
          "end_line": 4,
          "contains": [
            "FROM accounts"
          ]
        },
        {
          "file_path": "src/auth.py",
          "start_line": 6,
          "end_line": 6,
          "contains": [
            "user = find_user"
          ]
        }
      ],
      "expected_facts": [
        "login_user 调用 find_user，查询 accounts 表。"
      ]
    },
    {
      "id": "accounts-05",
      "repository": "accounts",
      "category": "impact",
      "question": "修改 login_user 会影响什么？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/api.py",
          "start_line": 11,
          "end_line": 11,
          "contains": [
            "return login_user"
          ]
        },
        {
          "file_path": "tests/check_auth.py",
          "start_line": 6,
          "end_line": 6,
          "contains": [
            "login_user(database"
          ]
        }
      ],
      "expected_facts": [
        "create_session 直接调用 login_user，相关验证在 tests/check_auth.py；静态关系不是完整运行时调用图。"
      ]
    },
    {
      "id": "accounts-06",
      "repository": "accounts",
      "category": "config",
      "question": "SESSION_TTL 如何配置？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/settings.py",
          "start_line": 4,
          "end_line": 4,
          "contains": [
            "os.getenv(\"SESSION_TTL\", \"1800\")"
          ]
        }
      ],
      "expected_facts": [
        "读取 SESSION_TTL 环境变量，默认 1800 秒。"
      ]
    },
    {
      "id": "accounts-07",
      "repository": "accounts",
      "category": "test",
      "question": "哪些测试覆盖了 login_user？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "tests/check_auth.py",
          "start_line": 4,
          "end_line": 4,
          "contains": [
            "def check_login_rejects_missing_user"
          ]
        }
      ],
      "expected_facts": [
        "check_login_rejects_missing_user 验证不存在的用户被拒绝。"
      ]
    },
    {
      "id": "accounts-08",
      "repository": "accounts",
      "category": "error",
      "question": "invalid credentials 错误在哪里转换为 HTTP 状态码？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/api.py",
          "start_line": 13,
          "end_line": 13,
          "contains": [
            "status_code=401"
          ]
        }
      ],
      "expected_facts": [
        "create_session 捕获 ValueError，转换为 HTTP 401。"
      ]
    },
    {
      "id": "accounts-09",
      "repository": "accounts",
      "category": "follow_up",
      "question": "它最后访问哪张表？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/models.py",
          "start_line": 4,
          "end_line": 4,
          "contains": [
            "FROM accounts"
          ]
        }
      ],
      "expected_facts": [
        "这里的它指上一轮 login_user，最终读取 accounts 表。"
      ],
      "history": [
        {
          "role": "user",
          "content": "login_user 在哪里？"
        },
        {
          "role": "assistant",
          "content": "定义为 `login_user`，位于 `src/auth.py:4-9`。"
        }
      ]
    },
    {
      "id": "accounts-10",
      "repository": "accounts",
      "category": "unanswerable",
      "question": "quantumTeleport 在哪里？",
      "expected_behavior": "insufficient",
      "expected_evidence": [],
      "expected_facts": [
        "未发现 quantumTeleport，不能把相似函数当作它。"
      ]
    },
    {
      "id": "accounts-11",
      "repository": "accounts",
      "category": "unanswerable",
      "question": "quantumTeleport 的测试用例在哪里？",
      "expected_behavior": "insufficient",
      "expected_evidence": [],
      "expected_facts": [
        "不存在该目标；不要返回现有的登录测试冒充。"
      ]
    },
    {
      "id": "accounts-12",
      "repository": "accounts",
      "category": "project_context",
      "question": "what is the name of the current project",
      "expected_behavior": "project_context",
      "expected_evidence": [],
      "expected_facts": [
        "当前记录名称为 accounts。"
      ]
    },
    {
      "id": "orders-01",
      "repository": "orders",
      "category": "startup",
      "question": "How to start this project?",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "package.json",
          "start_line": 5,
          "end_line": 5,
          "contains": [
            "\"dev\": \"tsx src/server.ts\""
          ]
        },
        {
          "file_path": "README.md",
          "start_line": 8,
          "end_line": 8,
          "contains": [
            "npm run dev"
          ]
        }
      ],
      "expected_facts": [
        "启动命令 npm run dev，对应 tsx src/server.ts。"
      ]
    },
    {
      "id": "orders-02",
      "repository": "orders",
      "category": "location",
      "question": "createOrder 在哪里实现？",
      "expected_behavior": "evidence",
      "expected_evidence": [
        {
          "file_path": "src/orders.ts",
          "start_line": 3,
          "end_line": 3,
          "contains": [
            "export function createOrder"
          ]
        }
      ],
      "expected_facts": [
        "业务实现在 src/orders.ts，不是生成的 client.min.js。"
      ]
    },
    {
      "id": "orders-03",
      "repository": "orders",
      "category": "api",
      "question": "订单创建接口使用什么路径和请求方法？",
