DEVATLAS_ENV=development
DEVATLAS_DATABASE_URL=sqlite:///./data/devatlas.db
DEVATLAS_REPOSITORY_ROOT=./data/repositories
DEVATLAS_TEMPORARY_ROOT=./data/tmp
DEVATLAS_SEARCH_INDEX_ROOT=./data/indexes
DEVATLAS_SEMANTIC_SEARCH_ENABLED=true
DEVATLAS_PROVIDER_CONFIG_PATH=./data/report-providers.json
DEVATLAS_MAX_UPLOAD_MB=200
DEVATLAS_MAX_FOLDER_FILES=20000
DEVATLAS_MAX_SOURCE_FILE_MB=5
DEVATLAS_MAX_ARCHIVE_ENTRIES=60000
DEVATLAS_MAX_EXTRACTED_MB=500
DEVATLAS_ALLOWED_ORIGINS=http://localhost:5173
